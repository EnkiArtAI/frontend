# Enki Art environment variables: NAMES ONLY, never values. Copy to .env.local.
# Devs never receive production values. Each developer gets a DEV file that
# scripts/make-dev-env.mjs builds for their tier (see docs/DEV-ENV.md):
#   core        every developer (frontend, most tasks)
#   generation  core + image providers (only who works on generation)
#   payments    core + wallet, payments, login (only backend devs on those parts)
# "generated" = the script creates a fresh dev-only value; "dashboard" = comes
# from the dev project's dashboard; "fixed" = a known dev value.

# ============================ core ============================
# app
NEXT_PUBLIC_APP_NAME=                 # fixed: "Enki Art (dev)"
NEXT_PUBLIC_APP_URL=                  # fixed: http://localhost:3008. Also the CDP JWT issuer and the OAuth redirect origin in production
NEXT_PUBLIC_SITE_ORIGIN=              # fixed: same as NEXT_PUBLIC_APP_URL
WEBAUTHN_ORIGIN=                      # fixed: same origin; passkeys are bound to it. Production MUST set the real origin
WEBAUTHN_RP_ID=                       # optional: only when the RP id differs from the origin host
TEAM_ACCESS_CODE=                     # generated: private beta gate; unset = gate off
NEXT_PUBLIC_TERMS_URL=                # optional
NEXT_PUBLIC_PRIVACY_URL=              # optional
NEXT_PUBLIC_ACCESS_REQUEST_EMAIL=     # optional

# database: the enki-dev Supabase project for developers, production only on Vercel
SUPABASE_URL=                         # dashboard
SUPABASE_SERVICE_ROLE_KEY=            # dashboard, server only
SUPABASE_ANON_KEY=                    # dashboard (the code reads SUPABASE_ANON_KEY, not NEXT_PUBLIC_*)

# environment secrets: generated ONCE per environment (--new-environment), then identical for everyone on that database
AUTH_PEPPER=                          # vault: seasons password hashes; unrotatable by design
FIELD_ENCRYPTION_KEY_B64=             # vault: AES-256-GCM key for prompts, emails, TOTP secrets; rows are unreadable with a different key
FIELD_ENCRYPTION_KEYS_RETIRED=        # optional: "kid:base64,kid:base64" decrypt-only keys after a rotation
CONTENT_ACCESS_TOKEN_SECRET=          # vault (legacy content tokens; JWT_SECRET is the old name)

# chain: devnet for everyone except production
SOLANA_PAYMENT_CHAIN=                 # fixed: solana-devnet (production: solana)
SOLANA_RPC_URL=                       # fixed: https://api.devnet.solana.com (production: the Helius mainnet URL, applied on mainnet only)
SOLANA_PLATFORM_WALLET=               # fixed dev: a generated public key that receives devnet fees
NEXT_PUBLIC_SOLANA_PLATFORM_WALLET=   # same value
NEXT_PUBLIC_PROGRAM_ID=               # optional: on-chain program id when the anchor client is used

# optional services (empty = the feature is off and says so)
BLOB_READ_WRITE_TOKEN=                # dashboard: Vercel dev blob store (storage moves to Cloudflare R2, see ClickUp REC-8)
RESEND_API_KEY=                       # dashboard: mail
EMAIL_FROM=                           # fixed: onboarding@resend.dev until a domain is verified
POLLINATIONS_TOKEN=                   # optional: free model, works without a token
POLLINATIONS_REFERRER=                # optional
POLLINATIONS_MAX_PIXELS=              # optional

# ========================= generation =========================
# one key PER DEVELOPER with a hard spend cap in the provider console; revoke when the task ends
GEMINI_API_KEY=                       # dashboard (GOOGLE_GEMINI_API_KEY is the legacy name, same key)
GEMINI_TIER=                          # optional: free | paid, steers rate limits
OPENAI_API_KEY=                       # dashboard (OPENAI_API_KEYS accepts a comma list for rotation)
WAVESPEED_API_KEY=                    # dashboard
XAI_API_KEY=                          # dashboard, optional: dice suggestions
XAI_DICE_MODEL=                       # optional
METERED_MAX_IMAGES=                   # fixed: 1. scripts/metered-guard.mjs refuses count fields above it
METERED_BUDGET=                       # per run: number of approved paid calls for a __bench-* script

# ====================== payments and login ====================
SOLANA_FEE_PAYER_SECRET_KEY=          # generated: devnet keypair as a JSON byte array (or base58); fund it at faucet.solana.com. Pays fees and rent only
WALLET_JWT_PRIVATE_KEY=               # generated: RSA PKCS8 PEM, base64 (scripts/gen-wallet-jwt-key.mjs), signs the CDP wallet JWT
WALLET_JWT_AUDIENCE=                  # optional: defaults to NEXT_PUBLIC_CDP_PROJECT_ID
NEXT_PUBLIC_CDP_PROJECT_ID=           # dashboard: Coinbase CDP dev project
CDP_API_KEY_ID=                       # dashboard: also used by the onramp route
CDP_SECRET_KEY=                       # dashboard
GOOGLE_OAUTH_CLIENT_ID=               # dashboard: dev OAuth client, redirect <APP_URL>/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_SECRET=           # dashboard
X_OAUTH_CLIENT_ID=                    # dashboard: X dev app (Pay Per Use, production environment), redirect <APP_URL>/api/auth/oauth/x/callback
X_OAUTH_CLIENT_SECRET=                # dashboard
MOONPAY_API_KEY=                      # optional: fiat ramp fallback
MOONPAY_SECRET_KEY=                   # optional
MOONPAY_PUBLISHABLE_KEY=              # optional
TWILIO_ACCOUNT_SID=                   # optional: SMS factor, not offered yet
TWILIO_AUTH_TOKEN=                    # optional
TWILIO_FROM=                          # optional

# ========================== kev only ==========================
# Read by scripts/db-copy.mjs (npm run db:copy), which copies the live database
# into the enki-dev Supabase project and re-keys it. Never in a developer's file.
SUPABASE_ACCESS_TOKEN=                # https://supabase.com/dashboard/account/tokens: personal access token for the Management API
SUPABASE_DB_PASSWORD=                 # live project > Settings > Database > database password (pg_dump over the session pooler)
PG_BIN=                               # optional: directory holding pg_dump and psql; otherwise PATH, then a one time download into the OS temp dir
# The copy's own values are written into the DEV env file by the script:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_PASSWORD_DEV (the copy's database password, kept for --reset).

# ============================ legacy ==========================
# read by code that is being retired; leave empty
THIRDWEB_SECRET_KEY=                  # EVM x402 engine (dormant)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=       # EVM wallet UI (dormant)
SERVER_WALLET_ADDRESS=                # EVM receiving wallet (dormant)
PROMPT_ENCRYPTION_KEY=                # decrypt-only fallback for the old prompt key
DYNAMIC_JWT_PRIVATE_KEY=              # old name of WALLET_JWT_PRIVATE_KEY
