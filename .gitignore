node_modules
dist
.next
.idea
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Environment files
.env
.env.*
!.env.example

# Keys / certs
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Local databases
*.sqlite
*.sqlite3
*.db

# Secret config
secrets.yml
secrets.yaml
credentials.json
service-account*.json

# Documentation files - ignore all .md files except README.md
*.md
!README.md
!CONTRIBUTING.md
# Local environment files
.env.local
.env*.local

# Standardized on npm; ignore stray pnpm lockfiles
pnpm-lock.yaml

# Vercel CLI project linking (do not commit)
.vercel

# Tracked documentation is allowed (exception to the global *.md ignore)
!docs/*.md

# Spec-driven workflow (AGENT_INSTRUCTIONS.md): docs/specs/<CODE>.md and the
# batch reports under docs/specs/batches/ are tracked too. `!docs/*.md` above
# does not reach into subdirectories (gitignore globs don't cross `/`), so
# without this, every spec and batch report is silently dropped from git.
!docs/specs/
!docs/specs/*.md
!docs/specs/batches/
!docs/specs/batches/*.md

# bun's own lockfile — this repo standardized on npm for the root project;
# backend/ was bun-installed locally purely for install speed, not as a
# package-manager switch. Keep backend/package-lock.json authoritative and
# don't let a second lockfile format drift in unnoticed (see ENG-09).
bun.lock

# Throwaway probes and benchmarks — never committed. They may call paid
# provider APIs, so a stray file here costs real money on every test run.
__bench-*
__live-*
*.live.test.ts
bench-output/
