node_modules
dist
.next
.idea
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Environment files
.env
.env.*
!.env.example

# Keys / certs
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Local databases
*.sqlite
*.sqlite3
*.db

# Secret config
secrets.yml
secrets.yaml
credentials.json
service-account*.json

# Documentation files - ignore all .md files except README.md
*.md
!README.md
!CONTRIBUTING.md
# Local environment files
.env.local
.env*.local

# Standardized on npm; ignore stray pnpm lockfiles
pnpm-lock.yaml

# Vercel CLI project linking (do not commit)
.vercel

# Tracked documentation is allowed (exception to the global *.md ignore)
!docs/*.md

# Throwaway probes and benchmarks — never committed. They may call paid
# provider APIs, so a stray file here costs real money on every test run.
__bench-*
__live-*
*.live.test.ts
bench-output/
